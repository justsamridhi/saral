{
  "manifest_version": 3,
  "name": "SARAL Companion",
  "version": "1.0.0",
  "description": "Smart shopping rewards, subscription monitor, and password security companion for SARAL.",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://*.supabase.co/*",
    "https://api.pwnedpasswords.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/crypto.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
